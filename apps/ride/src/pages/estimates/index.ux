<!-- apps/ride/src/pages/estimates/index.ux -->
<import name="mi-button" src="../../shared/components/button.ux"></import>
<import name="mi-header" src="../../shared/components/header.ux"></import>

<template>
	<div class="mi-page" @swipe="handleSwipe">
		<scroll class="mi-scroll" scroll-y="true">
			<div class="mi-viewport">
				<div class="mi-step-container">
					<div class="mi-row">
						<mi-header title="Available Rides"></mi-header>
					</div>

					<div if="{{ loading }}" class="mi-row">
						<text class="mi-text">Fetching live ride estimates...</text>
					</div>

					<div if="{{ !loading && estimates.length === 0 }}" class="mi-row">
						<text class="mi-text">No rides available for destination.</text>
					</div>

					<div for="{{ estimates }}" class="mi-row">
						<mi-button
							label="{{ $item.providerName }} • ${{ $item.price }} • {{ $item.eta }}m"
							classes="mi-accent mi-last"
							@tap="handleBookRide($item)"
						></mi-button>
					</div>
				</div>
			</div>
			<div class="mi-spacer"></div>
		</scroll>
	</div>
</template>

<script>
import app from "@system.app";
import MiPage from "../../shared/modules/page.js";

const page = MiPage({
	protected: {
		destinationId: "",
		destinationName: "",
		capacity: "4",
	},

	private: {
		estimates: [],
		loading: true,
	},

	onInit() {
		this.send("getEstimates", {
			destinationId: this.destinationId,
			capacity: Number(this.capacity) || 4,
		});
	},

	onMessage(message) {
		if (message.estimates) {
			this.estimates = message.estimates;
			this.loading = false;
		}
	},

	handleBookRide(estimate) {
		this.send("book", {
			fareId: estimate.fareId,
			provider: estimate.provider,
			destinationId: this.destinationId,
			capacity: Number(this.capacity) || 4,
		});
		app.terminate();
	},
});

export default page;
</script>

<style lang="less">
@import "../../shared/styles/theme.less";

.mi-step-container {
	width: 100%;
	flex-direction: column;
	align-items: center;
}
</style>
